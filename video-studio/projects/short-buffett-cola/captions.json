[
 {
  "start": 0.13,
  "end": 2.52,
  "text": "While other kids played with toys"
 },
 {
  "start": 2.52,
  "end": 4.57,
  "text": "Warren played with *numbers*."
 },
 {
  "start": 4.57,
  "end": 12.24,
  "text": "At just 6, he bought a 6-pack of Coca-Cola from his grandfather's grocery store for *25 cents*."
 },
 {
  "start": 12.24,
  "end": 14.85,
  "text": "He sold each bottle for *5 cents*."
 },
 {
  "start": 14.85,
  "end": 17.11,
  "text": "So 6 bottles brought in 30 cents."
 },
 {
  "start": 17.11,
  "end": 19.19,
  "text": "Profit: just *5 cents*."
 },
 {
  "start": 19.19,
  "end": 21.72,
  "text": "You might say, what's 5 cents?"
 },
 {
  "start": 21.72,
  "end": 23.77,
  "text": "But that day, Warren understood:"
 },
 {
  "start": 23.77,
  "end": 27.8,
  "text": "*buy cheap, sell at value*, and keep adding up the profits."
 },
 {
  "start": 27.8,
  "end": 30.95,
  "text": "This thinking later built a company worth *billions*."
 },
 {
  "start": 31.42,
  "end": 34.37,
  "text": "*Like* the video, *share* it with your friends"
 },
 {
  "start": 34.37,
  "end": 36.05,
  "text": "and *subscribe* to the channel."
 }
]