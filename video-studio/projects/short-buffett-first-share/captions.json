[
 {
  "start": 0.15,
  "end": 3.93,
  "text": "At 11, Warren bought his *first share*."
 },
 {
  "start": 3.93,
  "end": 6.01,
  "text": "3 shares of Cities Service,"
 },
 {
  "start": 6.01,
  "end": 7.62,
  "text": "at *$38* per share."
 },
 {
  "start": 7.62,
  "end": 10.42,
  "text": "Soon, the share fell to *$27*."
 },
 {
  "start": 10.42,
  "end": 15.32,
  "text": "Warren panicked. As soon as it came back to *$40*, he sold."
 },
 {
  "start": 15.32,
  "end": 17.16,
  "text": "A small profit. And then..."
 },
 {
  "start": 17.16,
  "end": 21.0,
  "text": "...a few years later, the same share reached about *$200*."
 },
 {
  "start": 21.0,
  "end": 24.83,
  "text": "Warren learned *two lessons* he remembered all his life."
 },
 {
  "start": 24.83,
  "end": 27.81,
  "text": "First: don't get stuck on the price you paid."
 },
 {
  "start": 27.81,
  "end": 29.82,
  "text": "Second: don't rush."
 },
 {
  "start": 29.82,
  "end": 32.06,
  "text": "*Patience* is what makes real money."
 },
 {
  "start": 32.06,
  "end": 40.4,
  "text": "Friends, if this lesson helped you, *like* this video and *share* it with the friend who panics quickly in the stock market."
 },
 {
  "start": 40.82,
  "end": 42.5,
  "text": "and *subscribe* to the channel!"
 }
]